{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["@nuxt/kit", "@nuxt/schema", "@nuxtjs/tailwindcss", "@nuxtjs/i18n"]
  },
  "include": ["**/*.ts", ".nuxt/**/*.d.ts"],
  "exclude": [
    "dist",
    "node_modules"
  ],
}